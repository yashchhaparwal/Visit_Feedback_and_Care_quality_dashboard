# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
# SQLite file. Relative paths resolve from the server/ folder.
DB_PATH=data/carepal.db

# --- Feedback links ---
# Base URL families open. In dev this is the Vite server; in production, your domain.
PUBLIC_BASE_URL=http://localhost:5173
# Default number of days a feedback link stays valid.
LINK_EXPIRY_DAYS=7

# --- Weekly summary email ---
# Who receives the summary (comma separated).
OPS_EMAILS=ops@example.com
# Cron expression in Asia/Kolkata time. Default: Mondays 09:00.
SUMMARY_CRON=0 9 * * 1
# SMTP settings. If SMTP_HOST is empty the email is written to server/outbox/ instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TheCarePal Quality <quality@example.com>"
